# ============================================================================
# VeilChat Comprehensive .gitignore
# ============================================================================

# ----------------------------------------------------------------------------
# Operating System & IDE Files
# ----------------------------------------------------------------------------
*.class
*.log
*.swp
*.bak
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ / Android Studio
*.iml
*.ipr
*.iws
.idea/

# Visual Studio Code
.vscode/

# ----------------------------------------------------------------------------
# Flutter & Dart Build Output & Caches
# ----------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Android build artifacts
/android/app/debug/
/android/app/profile/
/android/app/release/
android/.gradle/
android/captures/
*.apk
*.aab

# iOS & macOS build artifacts
**/ios/Flutter/.last_build_id
ios/.symlinks/
ios/Pods/
ios/Podfile.lock

# Symbolication & Obfuscation
app.*.symbols
app.*.map.json

# ----------------------------------------------------------------------------
# Python Backend & Virtual Environments
# ----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/
ENV/
dist/
*.egg-info/

# ----------------------------------------------------------------------------
# VeilChat Sensitive Runtime Data & Media Storage
# ----------------------------------------------------------------------------
# Runtime user databases containing real passwords & chats (use .example templates)
server_users.json
server_offline.json
server_groups.json
server_profiles.json
server/server_users.json
server/server_offline.json
server/server_groups.json
server/server_profiles.json

# Out-of-band uploaded encrypted user media
media_uploads/
server/media_uploads/

# Local archives and test dumps
lib.zip
server.zip
check_veilchat.py

# ----------------------------------------------------------------------------
# AI Agent Toolkits, Virtual Environments & Local Reports
# ----------------------------------------------------------------------------
.ai-toolkit/
.agents/
skills-lock.json
*_REPORT.md
FINAL_*.md
MISSION_*.md
QA_*.md
SECURITY_*.md
TOOLKIT_*.md
VEILCHAT_ARCHITECTURE_AND_PRODUCT_AUDIT.md
VEILCHAT_DESIGN_SYSTEM.md
KNOWN_LIMITATIONS.md

# ----------------------------------------------------------------------------
# Sensitive Credentials & Signing Keys
# ----------------------------------------------------------------------------
*.keystore
*.jks
android/key.properties
android/app/google-services.json
ios/Runner/GoogleService-Info.plist
.env
.env.*
!.env.example

# ----------------------------------------------------------------------------
# Academic Reports & Internal Personal Documents
# ----------------------------------------------------------------------------
Documentaion.pdf
Proposal.pdf
scratch/
